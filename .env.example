# ─────────────────────────────────────────────────────────────
# 学生状态监测系统 — 配置样例
# 复制为 .env 后填写真实值。切勿把真实的 .env 提交到版本库。
# ─────────────────────────────────────────────────────────────

# ── 运行模式 ──────────────────────────────────────────────
# mock = 使用内置模拟数据（无外部接口时自测）；live = 调用真实考勤接口
DATA_MODE=mock
DEBUG=false
LOG_LEVEL=INFO

# ── 数据库（SQLite，WAL 模式） ────────────────────────────
DATABASE_URL=sqlite:///./data/monitor.db

# ── 采集调度 ──────────────────────────────────────────────
# 轮询「进行中/今日课程」签到详情的间隔（秒）
POLL_INTERVAL_SECONDS=300
# 只对「开始时间往前溯 N 分钟」到「当前」之间的课程抓详情，避免全量拉取
POLL_LOOKBACK_MINUTES=30
# 已结束课程的回补窗口（小时）：课程结束后仍会在该窗口内被复查，兜住延迟上传的签到
BACKFILL_WINDOW_HOURS=6
# 单次采集允许的最大并发请求数
COLLECT_CONCURRENCY=6
# 单个 HTTP 请求超时（秒）与重试次数
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
# 采集总开关（false 则只读不抓，用于排障）
COLLECT_ENABLED=true
# 是否启动后台常驻轮询。设 false 时仍可用「手动采集」按钮 / CLI 拉数据
RUN_BACKGROUND_JOBS=true
# 数据保留天数（超期自动清理，避免 SQLite 无限增长）
RETENTION_DAYS=400

# ── 判定规则 ──────────────────────────────────────────────
# 「严重异常」需要的连续无签到有课日数
SEVERE_CONSECUTIVE_DAYS=3
# 是否把「今日已开课但尚未结束」的课时计入连续异常天数
COUNT_IN_PROGRESS_DAY=false
# 「请假」在连续异常统计中是否视为已签到（true = 请假不算异常）
LEAVE_COUNTS_AS_PRESENT=true
# 签到状态判为「已到」的取值（逗号分隔）
PRESENT_STATUSES=出勤,迟到,早退,迟到早退
# 一节课缺勤人数超过该比例时，不做「应到未签到」推断（防止名单不准导致大面积误报）。
# 小班遇到集体缺勤容易触发，阈值太紧会整批漏判，故默认 0.8。
INFER_MAX_RATIO=0.8
# 没有班级名单时，用「历史上观测到上过该课的学生」作为应到集合反推缺勤。
# 默认 false，因为它**发现不了从来没来过的学生** —— 而那正是本系统最该抓的人
# （学生一次都没出现，就永远不会进入这个集合）。
# 权威应到名单请用 `python -m app.cli import enrollments 选课名单.xlsx`，
# 它建立的是"谁选了这门课"的事实关系，不受此开关影响。
INFER_FROM_HISTORY=false

# ── 隐藏路径与口令 ────────────────────────────────────────
# 前端挂载的隐藏子路径（无前导斜杠）
APP_BASE_PATH=change-me-to-a-random-slug
# 访问口令
GATE_PASSWORD=
# 会话签名密钥（部署时必须改成随机字符串）
SESSION_SECRET=
# 会话有效期（小时）
SESSION_TTL_HOURS=12
# 会话 Cookie 是否仅走 HTTPS。生产（nginx 终止 TLS）设为 true；
# 若要用 http://IP:端口 直连后端调试，必须设为 false，否则客户端不回传 Cookie 会 401。
SESSION_COOKIE_SECURE=false
# 允许的 Host 头（逗号分隔），留空不校验。生产建议填域名。
TRUSTED_HOSTS=

# ── 邮件告警 ──────────────────────────────────────────────
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_RECIPIENTS=
# 同一学生同一轮异常，多少小时内不重复发信
ALERT_COOLDOWN_HOURS=24
# 严重异常是否立即单独发信（否则并入每日汇总）
ALERT_SEVERE_IMMEDIATE=true
# 普通「异常」的每日汇总发信时刻（24 小时制整点；设为 -1 关闭定时汇总）
# 默认 18 点：课程基本结束、考勤数据已回传。没有异常时不会发信。
DIGEST_HOUR=18

# ── 考勤源 1：翰博尔「智慧课堂考勤汇总」 ──────────────────
HB_BASE_URL=
HB_ACCESS_KEY=
HB_ACCESS_KEY_SECRET=
# 是否校验考勤平台的 TLS 证书（默认 true，建议保持） 。
# 内网出口若有 HTTPS 解密/审计设备，证书会被替换成自签的，
# 表现为 SSLCertVerificationError，采集一条数据都拿不到。
# 先找网络管理员要根证书；实在拿不到才设 false（只影响考勤平台请求，
# 且会失去中间人防护）。用 tools/check_network.py 可自动诊断这一项。
HB_VERIFY_TLS=true
HB_APP_SOURCE=
HB_ENABLED=true
# 校区作用域关键词（逗号分隔）。翰博尔是**多校区共用**平台，接口没有校区
# 过滤参数，整所学校的课会一次性返回。用「节次名」这个天然带校区的字段切开
# （海南校区的节次叫「海南第一二节」，其它校区叫「第一二节」）。
# 留空 = 不过滤，全平台数据都收（仅用于排障）。
HB_CAMPUS_KEYWORDS=海南
# 学号作用域：上面那行切的是**课**，这里切的是**人**。
# 本院（海南国际学院）学号形态：202x + 学院码 29 + 0x + 3 + 序号 3 位 + 可选尾字母。
# 接口原样返回时会带平台账号前缀 cuc（可选，见 app/core/ids.py）。
# ⚠ 尾字母一定要写成可选的 [0-9A-Z]?：上线库里实测有 96 名本院学生学号
#   末尾是数字或没有尾字母，写死成必需字母会把他们当成别院的人删掉。
# 正则已锚定首尾；**不要**放宽成 \w 之类 —— 这条规则会真的删数据
# （python -m app.cli students --purge）。
HB_STUDENT_ID_SCOPE_ENABLED=true
HB_STUDENT_ID_PATTERN=(?i)^(cuc)?202\d290\d3\d{3}[0-9A-Z]?$

# ── 考勤源 2 / 3：待信息化处提供接口文档后填写 ────────────
SRC2_ENABLED=false
SRC2_BASE_URL=
SRC2_ACCESS_KEY=
SRC2_ACCESS_KEY_SECRET=

SRC3_ENABLED=false
SRC3_BASE_URL=
SRC3_ACCESS_KEY=
SRC3_ACCESS_KEY_SECRET=

# ── 学生名册导入 ──────────────────────────────────────────
# 学号中「年级」所在的切片（Python 切片写法，含头不含尾）
STUDENT_ID_YEAR_SLICE=0:4
# 学号中「专业代码」所在的切片。
# 本院学号形态 YYYY(4) + 学院(2) + 专业(3) + 3 + 序号(3) + N，
# 如 202400000001N → 2024 级 / 学院 29 / 专业 013。
# 留 4:6 会把整个学院切成一个「专业」，页面上全挤成一坨。
STUDENT_ID_MAJOR_SLICE=6:9
# 专业代码 → 中文名（学号里只有代码，不映示示例辅导员看不懂）
MAJOR_ALIASES=013=智能科学与技术,023=视觉传达设计,033=数字媒体技术

# ── 教务课表（把「5-7周」折算成具体日期）──────────────────
# 学期**第 1 周的周一**（ISO 日期）。`app.cli teach-schedule` 用它把
# 「5-7周 星期四 3-4节」折算成 2026-10-08 这样的具体课次日期。
# ⚠ 每学期都要核对：写错会让所有课次整体偏移 7 的倍数，
#   表现为"那天明明有课，系统却显示无课"（静默，不报错）。
# 2026 秋：已按「2026-10-10 是第 5 周周六」反推核对为 2026-08-31
# （曾误写成 2026-09-07，导致所有课次差一周）。
SEMESTER_WEEK1_MONDAY=2026-08-31

# ── 四级预警阈值（学校 2026-10-13 给的口径）────────────────
# 规则① 学生无记录预警：连续多少个「有效统计日」无有效考勤记录即提醒。
# 「有效统计日」= 当日有课 **且** 相关课程确实产生过考勤数据 ——
# 课没有考勤数据的日子不算数（那属于覆盖不足，不是学生缺勤）。
NO_RECORD_DAYS=3
# 规则② 监测覆盖不足提醒：这段时间内有课，但这些课在各考勤平台都没有
# 可用数据 → 提示示例辅导员用其它方式核实。
MONITOR_COVERAGE_DAYS=7
# 规则③ 长期缺少记录提醒的回看窗口（自然日）与判定门槛。
# 比例低于 LONG_TERM_MISSING_RATIO、且有效统计日不少于 MIN_DAYS、
# 有记录天数不超过 MAX_RECORDS 时才报（避免偶发缺勤被当成"长期"）。
LONG_TERM_MISSING_DAYS=14
LONG_TERM_MISSING_RATIO=0.3
LONG_TERM_MISSING_MIN_DAYS=3
LONG_TERM_MISSING_MAX_RECORDS=3
# 规则④ 为数据异常提醒（接口失败/课表缺失/课程无法匹配），无需阈值。
# 四级规则的判定逻辑与上线实测见 docs/四级预警与邮件通知-20261013.md
#
# 邮件相关（ALERT_EMAIL_ENABLED / ALERT_RECIPIENTS / DIGEST_HOUR / SMTP_*）
# 见本文件上半部分。注意：ALERT_RECIPIENTS 是**管理员**收件人，收数据类
# 预警；学生类预警按班发示示例辅导员，在页面「辅导员联系人」里配置。

# =====================================================================
# 中传教务接口（主轴数据源）—— 2026-10 新增
# =====================================================================
# 设计原则：**教务是主轴**，学生的应到课表全部由这里生成；
#          畅课_签到 / 翰博尔 这些签到源再适配到主轴上来。
#
# 下面所有值都是**占位符**，由部署人员在内网服务器上填写真实值。
# 代码里不出现任何接口地址、token、密钥 —— 一律从这里读。
#
# ⚠ 本文件是模板，会进版本库。
#   · 真实 token 只能填在服务器 /opt/student-monitor/.env
#   · 提交前 tools/check_isolation.py 会检查本文件不得含真实值
# ---------------------------------------------------------------------

# —— 总开关 ——
# false 时所有 CUC_* 功能不启用，系统照旧只用翰博尔。
CUC_ENABLED=false

# —— 接口根地址与认证 ——
# 填信息中心给的网关地址，例如 https://jw.example.edu.cn/api
CUC_BASE_URL=
# 认证方式二选一，用哪种取决于对方要求：
#   1) token 方式：填 CUC_TOKEN
#   2) AppKey/Secret 方式：填 CUC_APP_KEY / CUC_APP_SECRET（按对方要求的算法签名）
CUC_TOKEN=
CUC_APP_KEY=
CUC_APP_SECRET=
# 附加请求头（对方常要求带 appId / 渠道号之类），格式 头名=值，多个用英文分号分隔
# 例：CUC_EXTRA_HEADERS=appId=sm-monitor;X-Tenant=hic
CUC_EXTRA_HEADERS=
# 是否校验对方 HTTPS 证书。内网自签证书时才设 false。
CUC_VERIFY_TLS=true
# 单次请求超时（秒）与重试次数
CUC_HTTP_TIMEOUT_SECONDS=30
CUC_HTTP_MAX_RETRIES=2

# —— 五个数据源的接口路径（相对 CUC_BASE_URL）——
# 由部署人员按对方文档填写。留空则该数据源不启用。
#   ① 公共_校历                 → 只取「教学开始日期」（第一周周一）
#   ② 本科生院_本专科生基本信息   → 姓名 学号 专业 年级 班号
#   ③ 本研_学生选课             → 学号 学年学期 选课类别 教学班编码 课程编码
#   ④ 本研_课表                 → 课程编码 课序号 显示名称 周次 节次 星期 教室 记录id
#   ⑤ 畅课_签到                 → 记录id 学号 教学班编码 签到状态 签到时间 上课时间
CUC_PATH_CALENDAR=
CUC_PATH_STUDENTS=
CUC_PATH_ENROLLMENTS=
CUC_PATH_TIMETABLE=
CUC_PATH_CHECKINS=

# —— 当前学期 ——
# 选课/课表按学年学期筛选，格式与对方一致（例：2026-2027学年秋季学期）。
# 留空则由校历接口推断；推断不出时用这里的值兜底。
CUC_TERM=2026-2027学年秋季学期

# —— 字段名映射（可选）——
# 如果对方返回的键名与我们的默认猜测不同，在这里显式指定：
#   左边是我们的字段，右边是对方 JSON 里的键名
# 格式：我们的字段=对方的键，多个用英文分号分隔
# 例：CUC_FIELDS_STUDENT=student_no=sno;name=xm;major=zymc;class_name=bh
# 默认猜测见 app/adapters/cuc.py 的 CANDIDATES，多数情况留空即可。
CUC_FIELDS_CALENDAR=
CUC_FIELDS_STUDENT=
CUC_FIELDS_ENROLLMENT=
CUC_FIELDS_TIMETABLE=
CUC_FIELDS_CHECKIN=

# —— 联调用：只拉指定学号的数据（demo 模式）——
# 填自己的学号，`app.cli cuc-demo` 只取这一个人的数据，便于核对字段。
# 留空则 demo 模式报错退出，防止误拉全校数据。
CUC_DEMO_STUDENT_NO=

# —— 分页 ——
# 部分接口分页返回，这里给每页条数与最大页数（防止死循环）。
CUC_PAGE_SIZE=500
CUC_MAX_PAGES=200
